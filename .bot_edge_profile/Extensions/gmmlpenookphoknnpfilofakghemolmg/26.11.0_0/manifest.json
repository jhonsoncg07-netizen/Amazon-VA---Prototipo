{
   "action": {
      "default_icon": {
         "16": "img/icon/icon-32.png",
         "32": "img/icon/icon-32.png"
      },
      "default_title": "__MSG_extensionName__"
   },
   "author": "Rakuten",
   "background": {
      "service_worker": "js/bg.js"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "js/libs/snippet.js" ],
      "matches": [ "https://*.rakuten.com/*", "https://*.rakuten.co.uk/*" ],
      "run_at": "document_start"
   } ],
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "homepage_url": "https://www.rakuten.com/",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "img/icon/icon-128.png",
      "16": "img/icon/icon-32.png",
      "48": "img/icon/icon-64.png"
   },
   "incognito": "split",
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extensionName__",
   "optional_permissions": [ "notifications" ],
   "options_ui": {
      "open_in_tab": true,
      "page": "settings.html"
   },
   "permissions": [ "tabs", "webNavigation", "webRequest", "storage", "cookies", "alarms", "scripting" ],
   "short_name": "Rakuten",
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "26.11.0",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "workers/*.js", "*.css", "*.js", "fonts/*.woff", "fonts/*.woff2", "fonts/*.ttf", "fonts/*.otf", "img/*", "json/np-bloom.json" ]
   } ]
}
