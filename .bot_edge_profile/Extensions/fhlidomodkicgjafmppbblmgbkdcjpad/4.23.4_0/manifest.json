{
   "action": {
      "default_title": "RetailMeNot: Codes, Cash Back and Coupons"
   },
   "background": {
      "service_worker": "background.bundle.js"
   },
   "content_scripts": [ {
      "js": [ "inject.bundle.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_start"
   } ],
   "description": "Automatically finds the best promo codes and cash back as you shop online.",
   "host_permissions": [ "*://*/*" ],
   "icons": {
      "128": "./html/images/icon_128.png",
      "16": "./html/images/icon_16.png",
      "32": "./html/images/icon_32.png",
      "64": "./html/images/icon_64.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "88.0.0",
   "name": "RetailMeNot: Codes, Cash Back and Coupons",
   "permissions": [ "cookies", "scripting", "storage", "tabs", "webNavigation", "webRequest", "declarativeNetRequestWithHostAccess" ],
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "4.23.4",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "assets/*", "html/permissions.html" ]
   } ]
}
