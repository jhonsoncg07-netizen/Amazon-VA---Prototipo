<file path=".github/workflows/amazon-spy.yml">
name: Amazon Storefront Spy - Cloud Bot

on:
  schedule:
    # Ejecutar cada 3 horas (Minuto 0)
    - cron: '0 */3 * * *'
  workflow_dispatch: # Permite ejecutar el bot manualmente desde GitHub

# Permisos explícitos para que el GITHUB_TOKEN pueda escribir en el repo
permissions:
  contents: write

jobs:
  run-scraper:
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Checkout del repositorio
        uses: actions/checkout@v4
        with:
          # fetch-depth: 0 descarga todo el historial para que git push funcione correctamente
          fetch-depth: 0
          # persist-credentials inyecta el token de GitHub en la URL remota automáticamente
          persist-credentials: true
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: ⚙️ Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: 📦 Instalar dependencias
        run: npm ci

      - name: 🌐 Instalar navegadores Playwright (Chromium)
        run: npx playwright install --with-deps chromium

      - name: 🕵️ Ejecutar Amazon Storefront Spy
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          SHOW_BROWSER: false
        run: npm run spy

      - name: 💾 Commit y Push de los nuevos datos
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email 'github-actions[bot]@users.noreply.github.com'

          # Aseguramos que la carpeta de datos exista (por si es la primera ejecución)
          mkdir -p data

          # Stage del archivo de base de datos horizontal
          git add data/mock-db.json

          # Verificar si hay cambios reales antes de intentar el commit
          if git diff-index --quiet HEAD --; then
            echo "ℹ️ No hay cambios nuevos en el inventario. Nada que pushear."
          else
            git commit -m "🤖 Auto-update [$(date -u '+%Y-%m-%d %H:%M UTC')]: Escaneo horizontal de Amazon completado"
            git push origin HEAD:main
            echo "✅ Base de datos horizontal actualizada y pusheada al repositorio con éxito."
          fi
</file>

